# ══════════════════════════════════════════════════════════════════════════════
# Backend — Variables de entorno
# Archivo: turismo_api/.env
#
# ⚠️  NUNCA subir este archivo a Git. Está en .gitignore.
# ⚠️  Para producción, configurar estas variables directamente en el servidor
#     (Railway, Render, Docker env, etc.) — no usar este archivo.
#
# Copia este archivo como punto de partida:
#     cp .env.example .env
# ══════════════════════════════════════════════════════════════════════════════

# ── Entorno ──────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true

# ── API ──────────────────────────────────────────────────────────────────────
API_V1_PREFIX=/api/v1
PROJECT_NAME=Plataforma Turística API
PROJECT_VERSION=1.0.0

# ── Base de datos PostgreSQL + PostGIS ────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nilo_turismo
POSTGRES_USER=postgres
POSTGRES_PASSWORD="0"

# Pool de conexiones
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ── Seguridad ─────────────────────────────────────────────────────────────────
# Generar en producción con: openssl rand -hex 32
SECRET_KEY=dev-secret-key-insegura-cambiar-en-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── CORS ──────────────────────────────────────────────────────────────────────
#
# FORMATO CORRECTO para pydantic-settings 2.x con list[AnyHttpUrl]:
#   Valores separados por comas, SIN corchetes, SIN comillas, SIN espacios.
#
# Pydantic V2 parsea esto como:
#   ["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
#
# FORMATO INCORRECTO (causa el bug de CORS):
#   CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]   ← Pydantic lo lee como 1 string
#   CORS_ORIGINS="http://localhost:5173, http://localhost:3000"      ← Las comillas externas lo rompen
#
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]
# ── Archivos estáticos ────────────────────────────────────────────────────────
STATIC_DIR=static
UPLOADS_DIR=static/uploads